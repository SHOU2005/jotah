{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/seo?file=robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?file=sitemap"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/_shell"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/guides/how-to-roll-with-rolling-paper",
      "destination": "/guides/how-to-fill-a-pre-rolled-cone",
      "permanent": true
    },
    {
      "source": "/guides/what-is-gsm-in-rolling-paper",
      "destination": "/guides/what-does-13-8-gsm-mean",
      "permanent": true
    },
    {
      "source": "/guides/rolling-paper-sizes-explained",
      "destination": "/guides/pre-rolled-cone-sizes-explained",
      "permanent": true
    },
    {
      "source": "/guides/slow-burn-rolling-papers",
      "destination": "/guides/slow-burn-cones",
      "permanent": true
    },
    {
      "source": "/guides/how-to-store-rolling-papers",
      "destination": "/guides/how-to-store-pre-rolled-cones",
      "permanent": true
    },
    {
      "source": "/guides/rolling-papers-india-buying-guide",
      "destination": "/guides/pre-rolled-cones-india-buying-guide",
      "permanent": true
    },
    {
      "source": "/guides/where-to-buy-rolling-papers-gurgaon",
      "destination": "/guides/where-to-buy-pre-rolled-cones-gurgaon",
      "permanent": true
    },
    {
      "source": "/guides/rolling-paper-glossary",
      "destination": "/guides",
      "permanent": true
    }
  ]
}
